# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Your live address (used for sharing previews and the sitemap)
NEXT_PUBLIC_SITE_URL=https://okaresorts.com

# OPTIONAL — Cloudflare Turnstile (free CAPTCHA) for the /admin login.
# 1) Create a Turnstile widget at dash.cloudflare.com -> Turnstile, copy the SITE key here.
# 2) In Supabase: Authentication -> Attack Protection -> enable CAPTCHA, choose Turnstile, paste the SECRET key.
# Leave this empty to run without CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
